{
	"dependencies": {
		"cheerio": "^1.2.0",
		"express": "^5.2.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.2",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sort-keys-custom-order": "^3.1.2",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"prettier": "3.9.8",
		"qrcode": "^1.5.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"homepage": "https://cheese-greater.github.io/MTB-openings/",
	"name": "my-react-app",
	"packageManager": "yarn@4.10.3",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/cheese-greater/MTB-openings.git"
	},
	"scripts": {
		"build": "node scripts/gen-qr.mjs && tsc -b && vite build",
		"build:data": "node scripts/build-data.mjs",
		"deploy": "yarn build && rsync -av --exclude=node_modules --exclude=src --exclude=.git --exclude=.yarn . jelly@192.168.1.117:~/mtb-trails/ && ssh jelly@192.168.1.117 'cd ~/mtb-trails && yarn install && sudo systemctl restart mtb-trails'",
		"deploy:local": "yarn build && node server.mjs",
		"dev": "concurrently \"node server.mjs\" \"vite\"",
		"gen-qr": "node scripts/gen-qr.mjs",
		"lint": "eslint .",
		"preview": "vite preview",
		"probe": "node scripts/probe-sources.mjs",
		"start": "node server.mjs",
		"test": "yarn test:unit && yarn test:e2e",
		"test:e2e": "playwright test",
		"test:unit": "node --test \"test/unit/**/*.test.mjs\"",
		"update": "node scripts/update.mjs"
	},
	"type": "module",
	"version": "0.0.0"
}
